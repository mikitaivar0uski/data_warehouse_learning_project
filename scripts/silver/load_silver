select * from (SELECT [cst_id]
      ,[cst_key]
      ,TRIM([cst_firstname]) AS cst_firstname
      ,TRIM(cst_lastname) AS cst_lastname,
      CASE 
        WHEN TRIM(UPPER(cst_marital_status)) = 'M' THEN 'Married'
        WHEN TRIM(UPPER(cst_marital_status)) = 'F' THEN 'Single'
        ELSE 'N/A'
        END AS [cst_marital_status],
      CASE 
        WHEN UPPER(TRIM([cst_gndr])) = 'M' THEN 'Man'
        WHEN UPPER(TRIM([cst_gndr])) = 'F' THEN 'Female'
        ELSE 'N/A'    
      END [cast_gndr],
     [cst_create_date]
  FROM [DataWarehouse].[bronze].[crm_cust_info]
 where [cst_id] not in ( select cst_id FROM [DataWarehouse].[bronze].[crm_cust_info] group by cst_id having count(cst_id) > 1 ))as temp
